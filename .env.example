# PhishGuard Environment Configuration Template
# Copy this file to .env and supply actual values for local development.

# Application Core
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-insecure-key-to-a-cryptographically-secure-random-string-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,chrome-extension://*

# Database (PostgreSQL)
# Production / Local Docker: postgresql+asyncpg://phishguard:phishguard_pass@localhost:5432/phishguard_db
# Unit Test / Local Dev Fallback: sqlite+aiosqlite:///./phishguard_dev.db
DATABASE_URL=sqlite+aiosqlite:///./phishguard_dev.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Authentication & JWT
JWT_SECRET=change-this-jwt-secret-to-a-strong-random-key-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Threat Intelligence Providers
URLHAUS_API_ENABLED=true
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/
URLHAUS_TIMEOUT_SECONDS=2.0

PHISHTANK_API_ENABLED=false
PHISHTANK_API_KEY=optional_api_key_here
PHISHTANK_TIMEOUT_SECONDS=2.0

GOOGLE_SAFE_BROWSING_ENABLED=false
GOOGLE_SAFE_BROWSING_API_KEY=optional_google_cloud_key_here
GOOGLE_SAFE_BROWSING_TIMEOUT_SECONDS=2.0

# Detection & ML Settings
ML_MODEL_PATH=ml/models/phishguard_rf_v1.joblib
MIN_PHISHING_THRESHOLD=70.0
MIN_SUSPICIOUS_THRESHOLD=30.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

